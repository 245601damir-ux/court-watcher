# Скопируй в .env и заполни. Файл .env в .gitignore — в репозиторий не попадёт.

# Bearer-токен из запросов виджета Altegio (DevTools -> Network -> book_staff/521176)
ALTEGIO_TOKEN=

# Telegram: @BotFather -> /newbot
TG_TOKEN=
# https://api.telegram.org/bot<TG_TOKEN>/getUpdates -> result[].message.chat.id
TG_CHAT_ID=

# отбор кортов: "*" = все корты филиала, иначе слова через запятую
# (сравнение по НАЧАЛУ слова: "крыт" не поймает "открытый")
NAME_FILTER=*

# явные id кортов через запятую; заданы - перекрывают NAME_FILTER
STAFF_IDS=

# --- автобронь (пусто = выключена) ---
# часы для автоброни, например 22:00
BOOK_HOURS=
# типы кортов: крытый, открытый, стенка, пляжный
BOOK_KINDS=
# без имени и телефона бронь не делается
BOOK_NAME=
BOOK_PHONE=
BOOK_EMAIL=
# предохранители: за прогон и всего
BOOK_MAX=1
BOOK_TOTAL=4
